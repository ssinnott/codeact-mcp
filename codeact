#!/usr/bin/env python3
"""The codeact CLI — everything a human does to the helper library.

    ./codeact              what the library and its policies look like now
    ./codeact --help       every command, grouped

Works from anywhere; add it to your PATH or alias it:

    alias codeact='python3 /path/to/codeact-mcp/codeact'

No dependencies and nothing to build — it's the same standard-library code the
MCP server runs on, reached from a terminal instead of from a session.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "server"))

from codeact_mcp.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
